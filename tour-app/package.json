{
  "name": "imovel-tour",
  "version": "0.1.0",
  "private": true,
  "description": "Visita imersiva cinematográfica a partir das fotografias reais do imóvel",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
